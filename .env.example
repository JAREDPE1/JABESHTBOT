# Carpeta persistente para configuracion y estado
DATA_DIR=./data

# Carpeta de sesion de WhatsApp
AUTH_DIR=./data/sesion

# Carpeta temporal
TMP_DIR=./tmp

# Enviar cada canción también como archivo para guardar en la carpeta Música.
# Pon false si quieres recibir solamente el audio reproducible.
MUSIC_SEND_DOCUMENT=true

# Rutas opcionales si el sistema no encuentra estos comandos
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Solo necesario en Render/servicios web
PORT=3000

# Opcional: API autorizada para consultar DNI
# Puedes usar {dni} como marcador dentro de la URL.
DNI_API_URL=https://api.verificape.com/v2/dni/{dni}
DNI_API_TOKEN=

# Proveedor de IA: gemini u openai
AI_PROVIDER=gemini

# Gemini para comandos de IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=90000

# OpenAI para comandos de IA
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=90000

# Limites de salida para cualquier proveedor
IA_MAX_TOKENS=1200
DOC_MAX_TOKENS=4200

# Instagram: por defecto usa Instaloader para perfiles públicos.
# Si usas un Python fuera de .venv, indica aquí su ruta.
# INSTAGRAM_PYTHON=/ruta/a/python3
# Opcional: sesión de Instagram si el acceso anónimo es limitado.
# Crea la sesión con: .venv/bin/instaloader --login TU_USUARIO
# INSTAGRAM_SESSION_USER=
# Solo si el archivo de sesión está en otra ruta:
# INSTAGRAM_SESSION_FILE=
# Alternativa Graph API para una cuenta profesional propia:
# INSTAGRAM_MODE=graph
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com/v25.0

# Opcional: proveedor autorizado de consultas vehiculares por placa
# Debe ser HTTPS. {placa} representa la matrícula buscada.
# Sin esta variable, !placa muestra el enlace oficial de SUNARP.
VEHICULO_API_URL=
VEHICULO_API_TOKEN=

# Croma: consulta automatica SUNARP por placa (API externa)
# Obtener la clave en https://usecroma.com
CROMA_API_KEY=

# Conversación natural: saluda 'hola ia' y conversa por 20 minutos.
# Para generar PDF instala LibreOffice en Linux Mint.
# LIBREOFFICE_PATH=libreoffice

# Imagenes Gemini: desactivado por defecto (puede requerir facturacion).
# Se piden con lenguaje natural: 'IA, creame un hombre en la luna'.
IMAGE_GENERATION_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Opcional: si queda vacia usa GEMINI_API_KEY
GEMINI_IMAGE_API_KEY=

# Multimodal Gemini: fotos y PDF de hasta 8/10 MB
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
# Busquedas con Google Search grounding (puede consumir cuota/pago)
WEB_SEARCH_ENABLED=false
GEMINI_WEB_MODEL=gemini-2.5-flash
# Reconocimiento musical AudD (cuenta y API token)
AUDD_API_TOKEN=
# Memoria: solo se guarda cuando el usuario pide "recuerda que ..."
# Se borra con "olvida todo" o se consulta con "que recuerdas de mi".

# Proteccion de miembros: solo configura valores reales en tu .env privado.
# Numeros separados por comas; usa codigo de pais. Nunca publiques tu .env.
GROUP_PROTECTED_NUMBERS=
# Opcional: JID/LID de WhatsApp separado por comas para identidades privadas.
GROUP_PROTECTED_JIDS=
